# Copie para .env antes do `make up`. Valores só para desenvolvimento local.

# Postgres (fonte da verdade)
POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=helpdesk

# Semente do gerador de dados sintéticos (RF-61)
SEED=42
CUSTOMERS_PER_BRAND=5

# Chaves do Active Record Encryption: criptografam os segredos das contas de canal (ADR-019).
# Fora de produção há valores padrão só para desenvolvimento. Gere novas com: bin/rails db:encryption:init
# AR_ENCRYPTION_PRIMARY_KEY=
# AR_ENCRYPTION_DETERMINISTIC_KEY=
# AR_ENCRYPTION_KEY_DERIVATION_SALT=

# Segredo de cada conta de provedor (ADR-019). Precisa ser o mesmo no seed (web) e no channels-mock.
# Sem a variável, os dois usam "dev-secret-<conta>". Exemplo:
# PROVIDER_SECRET_INFINITEPAY_CHAT_MOCK=


# Segredo do HMAC do webhook plataforma → broker (RNF-23; 07, seção 5.2). Precisa ser o mesmo no
# worker e no broker. Sem a variável, os dois usam "dev-secret-broker" fora de produção.
# BROKER_WEBHOOK_SECRET=

# Agente mock (ADR-008, RF-38; src/agent-mock/README.md). Perfil: rapido, lento ou mudo.
# AGENT_PROFILE=rapido
# AGENT_SEED=42
# AGENT_LATENCY_MS=2000          # fixa ou faixa (1000-3000); sobrepõe o perfil
# AGENT_FAILURE_RATE=0           # de 0 a 1: fração de eventos sem resposta
# AGENT_CONCURRENCY=48           # threads do consumidor (inteiro >= 1); uma por partição. Não entra no config_hash
