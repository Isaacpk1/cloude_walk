{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.helpdesk.cloudwalk.local/v1/channels/whatsapp_send_response.json",
  "title": "Resposta da Cloud API do WhatsApp a POST /:phone_number_id/messages",
  "description": "Subconjunto fiel da resposta (07, seção 5.0; ADR-018). messages[0].id (wamid) vira a provider_message_id da entrega e casa com os statuses do webhook.",
  "type": "object",
  "required": [
    "messaging_product",
    "contacts",
    "messages"
  ],
  "properties": {
    "messaging_product": {
      "const": "whatsapp"
    },
    "contacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "input",
          "wa_id"
        ],
        "properties": {
          "input": {
            "description": "O to enviado, como foi enviado.",
            "type": "string",
            "minLength": 1
          },
          "wa_id": {
            "type": "string",
            "pattern": "^[1-9][0-9]{7,14}$"
          }
        }
      }
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          }
        }
      }
    }
  }
}
