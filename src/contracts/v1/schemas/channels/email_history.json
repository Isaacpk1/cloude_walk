{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.helpdesk.cloudwalk.local/v1/channels/email_history.json",
  "title": "Resposta do Gmail a users.history.list",
  "description": "Segundo passo da entrada de e-mail (07, seção 5.0; ADR-018): a partir do historyId do push, lista as mensagens novas. O adaptador busca cada uma em users.messages.get. Sem mudanças, history não vem.",
  "type": "object",
  "required": [
    "historyId"
  ],
  "properties": {
    "historyId": {
      "$ref": "#/$defs/history_id"
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/history_id"
          },
          "messagesAdded": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "message"
              ],
              "properties": {
                "message": {
                  "type": "object",
                  "required": [
                    "id",
                    "threadId"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "threadId": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "history_id": {
      "description": "uint64 que a API do Gmail devolve como texto.",
      "type": "string",
      "pattern": "^[0-9]+$"
    }
  }
}
