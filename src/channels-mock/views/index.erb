<section class="card">
  <h1>Simulador do cliente</h1>
  <p class="muted">Envia a mensagem como o webhook do chat do app (07, seção 5.0) para
    <code><%= platform_url %>/webhooks/chat/&lt;conta&gt;</code>, assinada com o segredo da conta
    (<code>X-Helpdesk-Signature</code>, ADR-019). A plataforma confirma com 202 só depois de gravar.</p>
  <form method="post" action="/chat/messages">
    <div class="row">
      <div>
        <label for="account">Conta do provedor (define a marca)</label>
        <select id="account" name="account">
          <% accounts.each do |account| %>
            <option value="<%= account %>" <%= "selected" if last&.account == account %>><%= account %></option>
          <% end %>
        </select>
      </div>
      <div>
        <label for="message_id">message_id (vazio gera um novo)</label>
        <input id="message_id" name="message_id" placeholder="chat_msg_...">
      </div>
      <div>
        <label for="account_id">Conta do cliente no app (account_id)</label>
        <input id="account_id" name="account_id" value="<%= last&.payload&.fetch("account_id", nil) || "acc_infinitepay_000021" %>">
      </div>
      <div>
        <label for="customer_ref">Referência do cliente (customer_ref)</label>
        <input id="customer_ref" name="customer_ref" value="<%= last&.payload&.fetch("customer_ref", nil) || "cus_ref_000021" %>">
      </div>
    </div>
    <label for="text">Mensagem</label>
    <textarea id="text" name="text" rows="2">meu repasse não caiu</textarea>
    <label class="inline"><input type="checkbox" name="tamper_signature" value="1"> Enviar com assinatura inválida (a plataforma deve recusar com 401)</label>
    <button type="submit">Enviar pelo chat</button>
    <button type="submit" name="pedir_humano" value="1" class="human" title="Envia o pedido explícito de humano no idioma da marca da conta (RN-34)">Pedir humano</button>
  </form>
</section>

<section class="card" id="canais">
  <h2>WhatsApp e e-mail</h2>
  <p class="muted">O WhatsApp entra como webhook da Cloud API (<code>/webhooks/whatsapp/&lt;conta&gt;</code>). O e-mail entra como
    notificação push do Gmail (<code>/webhooks/email/&lt;conta&gt;</code>): a plataforma busca o histórico e a mensagem nesta
    caixa simulada. As respostas da plataforma aparecem abaixo.</p>
  <form method="post" action="/whatsapp/messages">
    <h3>WhatsApp</h3>
    <div class="row">
      <div><label for="wa_account">Conta (define a marca)</label>
        <select id="wa_account" name="account"><% whatsapp_accounts.each do |a| %><option><%= a %></option><% end %></select></div>
      <div><label for="wa_from">Telefone do cliente (wa_id)</label><input id="wa_from" name="from" value="5511900000021"></div>
      <div><label for="wa_id">Id da mensagem (vazio gera)</label><input id="wa_id" name="message_id" placeholder="wamid...."></div>
    </div>
    <label for="wa_text">Mensagem</label>
    <textarea id="wa_text" name="text" rows="2">meu repasse não caiu</textarea>
    <label class="inline"><input type="checkbox" name="tamper_signature" value="1"> Assinatura inválida (401)</label>
    <button type="submit">Enviar pelo WhatsApp</button>
  </form>
  <form method="post" action="/email/messages">
    <h3>E-mail</h3>
    <div class="row">
      <div><label for="em_account">Conta (define a marca)</label>
        <select id="em_account" name="account"><% email_accounts.each do |a| %><option><%= a %></option><% end %></select></div>
      <div><label for="em_from">De</label><input id="em_from" name="from" value="Loja Exemplo &lt;loja.exemplo@example.com&gt;"></div>
      <div><label for="em_subject">Assunto</label><input id="em_subject" name="subject" value="Repasse não recebido"></div>
      <div><label for="em_thread">threadId (vazio abre uma conversa nova)</label><input id="em_thread" name="thread_id"></div>
      <div><label for="em_att">Anexo (nome do arquivo)</label><input id="em_att" name="attachment" placeholder="comprovante.pdf"></div>
    </div>
    <label for="em_text">Mensagem</label>
    <textarea id="em_text" name="text" rows="3">Meu repasse de ontem não caiu.</textarea>
    <label class="inline"><input type="checkbox" name="tamper_signature" value="1"> Assinatura inválida (401)</label>
    <button type="submit">Enviar por e-mail</button>
  </form>
  <h3>Respostas recebidas da plataforma</h3>
  <% if whatsapp_sent.empty? && email_sent.empty? %>
    <p class="muted">Nenhuma resposta ainda.</p>
  <% else %>
    <ul>
      <% whatsapp_sent.each do |m| %><li>WhatsApp para <code><%= m.to %></code> (<%= m.account %>): <%= m.text %></li><% end %>
      <% email_sent.each do |m| %><li>E-mail para <code><%= m.to %></code> (<%= m.account %>), <%= m.subject %>, thread <code><%= m.thread_id %></code>: <%= m.text %></li><% end %>
    </ul>
  <% end %>
</section>

<section class="card" id="agente">
  <h2>Perfil do agente mock</h2>
  <p class="muted">Troca o perfil do agente sem reiniciar (RF-38). O simulador grava a escolha no Redis de controle e o
    agente lê a cada evento novo; a marca vale antes do global, e "padrão" volta ao <code>AGENT_PROFILE</code> do agente.
    Também por script: <code>POST /simulador/agente/perfil</code> (README).</p>
  <table>
    <thead><tr><th>Perfil</th><th>Latência</th><th>O que demonstra</th></tr></thead>
    <tbody>
      <% agent_profile["profiles"].each do |profile| %>
        <tr><td><%= profile["title"] %> <code><%= profile["name"] %></code></td><td><%= profile["latency"] %></td><td><%= profile["demonstrates"] %></td></tr>
      <% end %>
    </tbody>
  </table>
  <% if agent_profile["available"] %>
    <% titles = agent_profile["profiles"].to_h { [ _1["name"], _1["title"] ] } %>
    <% sources = { "brand" => "escolhido para a marca", "global" => "escolhido para todas", "env" => "padrão do agente (AGENT_PROFILE)" } %>
    <h3>Ativo agora</h3>
    <table>
      <thead><tr><th>Escopo</th><th>Marca</th><th>Perfil ativo</th><th>Origem</th></tr></thead>
      <tbody>
        <% agent_profile["scopes"].each do |scope| %>
          <tr>
            <td><%= scope["scope"] %></td>
            <td><%= scope["brand"] || "todas" %></td>
            <td><strong><%= scope["effective"] ? titles.fetch(scope["effective"], scope["effective"]) : "padrão do agente" %></strong></td>
            <td class="muted"><%= sources.fetch(scope["source"], scope["source"]) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <form method="post" action="/simulador/agente/perfil">
      <div class="row">
        <div>
          <label for="agent_scope">Escopo</label>
          <select id="agent_scope" name="scope">
            <% agent_profile["scopes"].each do |scope| %>
              <option value="<%= scope["scope"] %>"><%= scope["scope"] == "global" ? "global (todas as marcas)" : scope["scope"] %></option>
            <% end %>
          </select>
        </div>
        <div>
          <label for="agent_profile">Perfil</label>
          <select id="agent_profile" name="profile">
            <% agent_profile["profiles"].each do |profile| %>
              <option value="<%= profile["name"] %>"><%= profile["title"] %></option>
            <% end %>
            <option value="padrao">Padrão do agente (AGENT_PROFILE)</option>
          </select>
        </div>
      </div>
      <button type="submit">Aplicar perfil</button>
    </form>
  <% else %>
    <p><span class="badge badge--err">Indisponível</span> <%= agent_profile["error"] %></p>
  <% end %>
</section>

<section class="card" id="cenarios">
  <h2>Cenários de rajada</h2>
  <p class="muted">Enviam várias mensagens do mesmo cliente em horários planejados, pelo mesmo webhook do formulário
    (RN-55, RN-56; 07, seção 3.4). Também por script: <code>POST /simulador/cenarios/&lt;nome&gt;</code> e
    <code>GET /simulador/cenarios/&lt;id&gt;</code> (README).</p>
  <form method="post" action="/simulador/cenarios/corrida-3s">
    <div class="row">
      <div>
        <label for="scenario_account">Conta do provedor (define a marca)</label>
        <select id="scenario_account" name="account">
          <% accounts.each do |account| %>
            <option value="<%= account %>" <%= "selected" if last&.account == account %>><%= account %></option>
          <% end %>
        </select>
      </div>
      <div></div>
      <div>
        <label for="scenario_account_id">Conta do cliente no app (account_id)</label>
        <input id="scenario_account_id" name="account_id" value="<%= last&.payload&.fetch("account_id", nil) || "acc_infinitepay_000021" %>">
      </div>
      <div>
        <label for="scenario_customer_ref">Referência do cliente (customer_ref)</label>
        <input id="scenario_customer_ref" name="customer_ref" value="<%= last&.payload&.fetch("customer_ref", nil) || "cus_ref_000021" %>">
      </div>
    </div>
    <ul class="scenarios">
      <% scenarios.each do |scenario| %>
        <li>
          <button type="submit" formaction="/simulador/cenarios/<%= scenario.name %>"><%= scenario.title %></button>
          <span class="muted"><%= scenario.rule %> · <%= scenario.steps.map { ChannelsMock::ScenarioView.offset(_1.at) }.join(", ") %></span>
          <div class="muted"><%= scenario.demonstrates %></div>
        </li>
      <% end %>
    </ul>
  </form>

  <% runs.each do |run| %>
    <h3>#<%= run["id"] %> · <%= run["title"] %> <span class="muted">(<%= run["rule"] %>)</span></h3>
    <p class="muted"><%= ChannelsMock::ScenarioView.status(run["status"]) %> · passo <%= run["current_step"] %>/<%= run["total_steps"] %>
      · <%= run["account"] %> · <code><%= run["account_id"] %></code> · <code><%= run["customer_ref"] %></code>
      · largada <%= ChannelsMock::ScenarioView.clock(run["started_at"]) %></p>
    <table>
      <thead><tr><th>Passo</th><th>Mensagem</th><th>Planejado</th><th>Real</th><th>Plataforma</th></tr></thead>
      <tbody>
        <% run["steps"].each do |step| %>
          <tr>
            <td><%= step["step"] %></td>
            <td><%= step["text"] %><% if step["message_id"] %><div class="muted"><code><%= step["message_id"] %></code></div><% end %></td>
            <td><%= ChannelsMock::ScenarioView.offset(step["at"]) %> · <%= ChannelsMock::ScenarioView.clock(step["planned_at"]) %></td>
            <td>
              <% if step["sent_at"] %>
                <%= ChannelsMock::ScenarioView.clock(step["sent_at"]) %> <span class="muted">(<%= ChannelsMock::ScenarioView.delay(step) %>)</span>
              <% else %><span class="muted">aguardando</span><% end %>
            </td>
            <td>
              <% if step["outcome"] %>
                <span class="badge badge--<%= { "Confirmada" => "ok", "Duplicada" => "dup" }.fetch(step["outcome"], "err") %>"><%= step["outcome"] %></span>
                <% if step["http_status"] %><code><%= step["http_status"] %></code><% end %>
                <% if step["error"] %><div class="muted"><%= step["error"] %></div><% end %>
                <% if step["trace_id"] %><div class="muted">trace <code><%= step["trace_id"] %></code></div><% end %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</section>

<section class="card">
  <h2>Provedor do chat: falhas simuladas</h2>
  <p class="muted">A plataforma entrega as respostas em <code>POST /provider/chat/&lt;conta&gt;/messages</code>
    (07, seção 5.0), com <code>Idempotency-Key</code> = <code>delivery_id</code>. Use as falhas para ver a retentativa
    e a conciliação (07, seção 3.2).</p>
  <p>Falha ativa: <code><%= fault["fault"] %></code>
    <% if fault["remaining"].positive? %><span class="muted">(próximas <%= fault["remaining"] %> entregas)</span><% end %></p>
  <form method="post" action="/simulador/falhas" class="row">
    <div>
      <label for="fault">Próximas entregas</label>
      <select id="fault" name="fault">
        <% { "none" => "Sem falha", "lose_ack" => "Perder a confirmação (grava e responde 504)",
             "unavailable" => "Recusar com 503 (transitório, sem efeito)",
             "reject" => "Recusar definitivo com 422 (sem efeito)" }.each do |value, label| %>
          <option value="<%= value %>" <%= "selected" if fault["fault"] == value %>><%= label %></option>
        <% end %>
      </select>
    </div>
    <div>
      <label for="times">Quantas vezes</label>
      <input id="times" name="times" type="number" min="1" value="1">
    </div>
    <div><button type="submit">Aplicar</button></div>
  </form>
</section>

<section class="card">
  <h2>Conversa</h2>
  <p class="muted"><a href="/?atualizar=3">Atualizar a cada 3 s</a> · <a href="/">Parar</a>.
    Tempo total = chegada da resposta ao provedor − envio do cliente (RNF-05, latência percebida).</p>
  <% if items.empty? %>
    <p class="muted">Nenhum envio ainda.</p>
  <% else %>
    <table>
      <thead><tr><th>#</th><th>Mensagem do cliente e respostas</th><th>Resposta da plataforma</th><th>Conversa</th><th></th></tr></thead>
      <tbody>
        <% items.each do |item| %>
          <% entry = item.entry %>
          <% css = { "Confirmada" => "ok", "Duplicada" => "dup" }.fetch(entry.outcome, "err") %>
          <tr>
            <td><%= entry.id %></td>
            <td>
              <%= entry.payload["text"] %>
              <div class="muted"><%= entry.account %> · <code><%= entry.payload["message_id"] %></code></div>
              <% if item.resend_of %><div class="muted">Reenvio do #<%= item.resend_of %>: as respostas aparecem lá.</div><% end %>
              <% unless item.replies.empty? %>
                <ul class="replies">
                  <% item.replies.each do |reply| %>
                    <%== render("_reply", locals: { record: reply.record, total: reply }) %>
                  <% end %>
                </ul>
              <% end %>
            </td>
            <td>
              <span class="badge badge--<%= css %>"><%= entry.outcome %></span>
              <% if entry.response&.status %><code><%= entry.response.status %></code><% end %>
              <% if entry.reason %><code><%= entry.reason %></code><% end %>
              <% if entry.tampered %><div class="muted">Enviada com assinatura inválida</div><% end %>
              <% if entry.error || entry.response&.error %>
                <div class="muted"><%= entry.error ? "Mensagem fora do contrato: #{entry.error}" : entry.response.error %></div>
              <% end %>
              <% if entry.response %><div class="muted">trace <code><%= entry.response.trace_id %></code></div><% end %>
            </td>
            <td>
              <% if entry.ticket_id %>
                <a href="<%= platform_url %>/conversas/<%= entry.ticket_id %>">Abrir conversa <%= entry.ticket_id %></a>
                <div><a href="<%= platform_url %>/linha-do-tempo/<%= entry.ticket_id %>">Linha do tempo</a></div>
              <% end %>
            </td>
            <td>
              <% if entry.response %>
                <form method="post" action="/chat/messages/<%= entry.id %>/resend">
                  <button class="secondary" type="submit" title="Reentrega o mesmo webhook, como um provedor faria">Reenviar o mesmo ID</button>
                </form>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</section>

<% unless orphans.empty? %>
  <section class="card">
    <h2>Respostas sem envio ligado</h2>
    <p class="muted">O <code>reply_to</code> não corresponde a nenhum envio deste simulador (por exemplo, depois de reiniciar o mock).</p>
    <ul class="replies">
      <% orphans.each do |record| %>
        <%== render("_reply", locals: { record:, total: nil }) %>
      <% end %>
    </ul>
  </section>
<% end %>
