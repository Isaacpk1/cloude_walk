<% c = @conversation %>
<% t = @timeline %>
<% content_for :title, "Linha do tempo #{t.ticket_id}" %>

<div class="page-header">
  <div>
    <h1>Linha do tempo <span class="muted"><%= t.ticket_id %></span></h1>
    <p class="page-header__subtitle"><%= c.title %> · <%= c.customer_name %> · <%= c.brand_name %></p>
  </div>
  <div class="page-header__actions">
    <%= source_badge(t.source) %>
    <%= link_to "Abrir conversa", conversation_path(c.id), class: "button" %>
  </div>
</div>

<dl class="stats">
  <div class="stat"><dt>Duração total</dt><dd><%= duration_text(t.total_duration_ms) %></dd></div>
  <div class="stat"><dt>Espera intencional</dt><dd><%= duration_text(t.duration_ms_of(:intentional_wait)) %></dd></div>
  <div class="stat"><dt>Execução do agente</dt><dd><%= duration_text(t.duration_ms_of(:agent_run)) %></dd></div>
  <div class="stat"><dt>Eventos</dt><dd><%= t.events.size %></dd></div>
</dl>

<% if @selected %>
  <%= render "selected_event", event: @selected, timeline: t %>
<% end %>

<table class="timeline">
  <thead>
    <tr>
      <th scope="col">Início</th>
      <th scope="col">Etapa</th>
      <th scope="col">Duração</th>
      <th scope="col" class="timeline__bar-col">Período</th>
      <th scope="col">ticket · seq · turno</th>
      <th scope="col">trace_id</th>
      <th scope="col">Origem</th>
    </tr>
  </thead>
  <tbody>
    <% t.events.each.with_index(1) do |event, position| %>
      <tr class="<%= class_names("timeline__row", "timeline__row--#{event.kind}", "timeline__row--selected" => event.equal?(@selected)) %>">
        <td><span class="mono">+<%= t.offset_ms(event) %> ms</span><div class="muted small"><%= panel_time(event.started_at, precise: true) %></div></td>
        <td><%= link_to timeline_path(c.id, evento: position), class: "timeline__pick", title: "Escolher o evento" do %><strong><%= event.label %></strong><% end %><% if event.error? %> <span class="badge badge--error">erro</span><% end %><% if event.detail %><div class="muted small"><%= event.detail %></div><% end %></td>
        <td class="mono"><%= duration_text(event.duration_ms) %></td>
        <td class="timeline__bar-col"><div class="bar"><span class="bar__fill bar__fill--<%= event.kind %>" style="<%= timeline_bar_style(t, event) %>"></span></div></td>
        <td class="mono small"><%= event.ticket_id %> · <%= event.seq ? "seq #{event.seq}" : "—" %> · <%= event.turn ? "turno #{event.turn}" : "—" %></td>
        <td><code class="small"><%= event.trace_id %></code></td>
        <td><%= source_badge(event.source) %></td>
      </tr>
    <% end %>
  </tbody>
</table>
