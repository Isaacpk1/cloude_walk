<% c = @conversation %>
<% content_for :title, "Conversa #{c.ticket_id}" %>
<%# Bloco 10 (RNF-06): o AuditEvent pede a recarga quando o caso escala ou o resumo chega. %>
<% unless c.source.synthetic? %>
  <% content_for :head do %><%= turbo_refreshes_with method: :morph, scroll: :preserve %><% end %>
  <%= turbo_stream_from(*c.stream) %>
<% end %>

<div class="page-header">
  <div>
    <h1>Conversa <span class="muted"><%= c.ticket_id %></span></h1>
    <p class="page-header__subtitle"><%= c.title %> · <%= c.customer_name %> · <%= c.brand_name %> · <%= c.channel %> · estado <code><%= c.state %></code></p>
  </div>
  <div class="page-header__actions">
    <%= source_badge(c.source) %>
    <%= link_to "Ver linha do tempo", timeline_path(c.id), class: "button" %>
  </div>
</div>

<% if flash[:notice] %><p class="flash flash--notice" role="status"><%= flash[:notice] %></p><% end %>
<% if flash[:alert] %><p class="flash flash--alert" role="alert"><%= flash[:alert] %></p><% end %>

<div class="conversation">
  <section class="conversation__messages" aria-label="Mensagens">
    <h2>Mensagens <span class="muted">(ordem do seq)</span></h2>
    <ol class="messages">
      <% c.messages.each do |message| %>
        <li class="message message--<%= message.author_type %>" id="seq-<%= message.seq %>">
          <div class="message__header">
            <span class="seq">seq <%= message.seq %></span>
            <%= author_badge(message) %>
            <strong><%= message.author_name %></strong>
            <% if message.internal %><span class="badge badge--internal" title="Nunca é enviada ao cliente (RN-50)">nota interna</span><% end %>
            <time class="muted" datetime="<%= message.occurred_at.iso8601(3) %>"><%= panel_time(message.occurred_at) %></time>
          </div>
          <p class="message__body"><%= message.body %></p>
          <div class="message__footer">
            <%= delivery_badge(message, c.source) %>
            <% if (covering = c.turns_covering(message.seq)).any? %>
              <span class="message__turns">entrou nos turnos
                <% covering.each do |turn| %>
                  <a class="message__turn chip chip--<%= turn.status %>" href="#turn-<%= turn.number %>">Turno <%= turn.number %></a>
                <% end %>
              </span>
            <% end %>
            <% if message.delivery_id %><code class="muted"><%= message.delivery_id %></code><% end %>
            <code class="muted" title="trace_id"><%= message.trace_id.first(8) %></code>
            <%= source_badge(c.source) %>
          </div>
          <% if message.delivery %><%= render "conversations/delivery", delivery: message.delivery %><% end %>
        </li>
      <% end %>
    </ol>
    <%= render "conversations/analyst_actions", conversation: c %>
  </section>

  <aside class="conversation__side">
    <% if c.triage || !c.source.synthetic? %><%= render "conversations/triage", triage: c.triage %><% end %>
    <% if c.grouping %><%= render "conversations/grouping", grouping: c.grouping %><% end %>
    <% if c.turn_refusal %><%= render "conversations/turn_refusal", refusal: c.turn_refusal %><% end %>
    <% if c.handoff %><%= render "conversations/handoff", handoff: c.handoff %><% end %>
    <% if c.handoff&.summary %><%= render "conversations/handoff_summary", summary: c.handoff.summary %><% end %>
    <% if c.handoff&.transfer_notice %><%= render "conversations/transfer_notice", notice: c.handoff.transfer_notice %><% end %>
    <% if c.deadlines %><%= render "conversations/deadlines", deadlines: c.deadlines %><% end %>
    <% c.reconciliations.each do |reconciliation| %><%= render "conversations/reconciliation", reconciliation: %><% end %>

    <% unless c.source.synthetic? %>
    <section class="card customer-history">
      <h2>Atendimentos anteriores do cliente</h2>
      <% if @history.empty? %>
        <p class="muted">Primeiro atendimento deste cliente.</p>
      <% else %>
        <ul>
          <% @history.each do |entry| %>
            <li data-ticket-id="<%= entry.ticket_id %>"><%= link_to "Conversa #{entry.ticket_id}", conversation_path(entry.ticket_id) %>
              · <%= entry.channel %> · <%= entry.state %> · <%= l(entry.created_at, format: :short) %>
              <% if entry.summary.present? %><p><%= entry.summary %></p><% end %></li>
          <% end %>
        </ul>
      <% end %>
    </section>
    <% end %>

    <section class="card">
      <h2>Responsável atual</h2>
      <p><strong><%= c.assignee.name %></strong> <span class="badge badge--assignee-<%= c.assignee.kind %>"><%= c.assignee.kind_label %></span></p>
      <p class="muted">assignment_version <%= c.assignment_version %> · latest_customer_seq <%= c.latest_customer_seq %></p>
    </section>

    <section class="card">
      <h2>Histórico de escalação</h2>
      <% if c.escalations.empty? %>
        <p class="muted">Nenhuma escalação. O caso segue com <%= c.assignee.name %>.</p>
      <% else %>
        <ol class="escalations">
          <% c.escalations.each do |escalation| %>
            <li>
              <strong><%= escalation.from %></strong> → <strong><%= escalation.to %></strong>
              <div class="muted"><%= escalation.trigger %> · <%= panel_time(escalation.occurred_at) %> · versão <%= escalation.assignment_version %></div>
              <div><%= escalation.reason %></div>
            </li>
          <% end %>
        </ol>
      <% end %>
    </section>

    <section class="card">
      <h2>Turnos da IA</h2>
      <% if c.turns.empty? %>
        <p class="muted">Nenhum turno enviado ao agente.</p>
      <% end %>
      <ol class="turns">
        <% c.turns.each do |turn| %>
          <li class="turn turn--<%= turn.status %>" id="turn-<%= turn.number %>">
            <div class="turn__header">
              <strong>Turno <%= turn.number %></strong>
              <%= turn_status_badge(turn) %>
              <span><%= covered_seqs_text(turn) %></span>
            </div>
            <% if turn.superseded_by_seq %>
              <p class="turn__superseded">
                Turno superado pela mensagem <a href="#seq-<%= turn.superseded_by_seq %>">seq <%= turn.superseded_by_seq %></a><% if turn.superseded_at %> em <time datetime="<%= turn.superseded_at.iso8601(3) %>"><%= panel_time(turn.superseded_at) %></time><% end %> (RN-56)
              </p>
            <% end %>
            <% if turn.context %>
              <%= render "conversations/turn_context", context: turn.context %>
            <% else %>
              <ul class="turn__messages">
                <% c.messages_in(turn).each do |message| %>
                  <li><a href="#seq-<%= message.seq %>">seq <%= message.seq %></a>: <%= message.body %></li>
                <% end %>
              </ul>
            <% end %>
            <dl class="turn__facts">
              <dt>context_until_seq</dt><dd><%= turn.context_until_seq %><%= " (não cobre a última mensagem)" unless c.covers_latest_customer_seq?(turn) %></dd>
              <dt>ação</dt><dd><code><%= turn.action %></code></dd>
              <% if turn.tool_calls.any? %><dt>tools</dt><dd><%= turn.tool_calls.join(", ") %></dd><% end %>
              <dt>event_id</dt><dd><code><%= turn.event_id.first(8) %></code></dd>
            </dl>
            <% if turn.note %><p class="muted"><%= turn.note %></p><% end %>
            <% if turn.agent_action %>
              <%= render "shared/agent_action", action: turn.agent_action %>
              <% if turn.stages %><%= render "conversations/turn_stages", stages: turn.stages %><% end %>
            <% elsif !c.source.synthetic? %>
              <p class="turn__response-state"><strong><%= turn.response_state_label %></strong></p>
            <% end %>
          </li><!-- /turn -->
        <% end %>
      </ol>
    </section>
  </aside>
</div>
