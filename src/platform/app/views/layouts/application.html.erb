<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <title><%= [ content_for(:title), "Help desk CloudWalk" ].compact.join(" · ") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Help desk CloudWalk">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# Fontes carregadas aqui (e não por @import no CSS) para não bloquear a primeira pintura. %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap">
    <meta name="turbo-prefetch" content="true">

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <% signed_in = respond_to?(:current_user) && current_user.present? %>
  <body class="<%= "body--public" unless signed_in %>">
    <% if signed_in %>
    <header class="topbar">
      <%= link_to root_path, class: "topbar__brand", aria: { label: "CloudWalk, Help desk, início" } do %>
        <%= render "shared/cloudwalk_logo" %>
        <span class="topbar__product">Help desk</span>
      <% end %>
      <nav class="nav" aria-label="Seções do painel">
        <%= nav_link "Conversas", conversations_path, active: controller_name == "conversations", icon: "conversations" %>
        <%= nav_link "Linha do tempo", timelines_path, active: controller_name == "timelines", icon: "timelines" %>
        <%= nav_link "Fila humana", human_queue_path, active: controller_name == "human_queue", icon: "human_queue" %>
        <% if respond_to?(:current_user) && current_user&.supervisor? %>
          <%= nav_link "Qualidade da IA", evals_path, active: controller_name == "evals", icon: "evals" %>
          <%= nav_link "Falhas", dead_letters_path, active: controller_name == "dead_letters", icon: "dead_letters" %>
          <%= nav_link "Configuração", configuration_path, active: controller_name.start_with?("configuration"), icon: "configuration" %>
        <% end %>
      </nav>
      <% if respond_to?(:current_user) && current_user %>
        <span class="topbar__user"><%= current_user.name %> · <%= current_user.role == "supervisor" ? "supervisor" : "analista" %></span>
        <%= button_to "Sair", logout_path, method: :delete, class: "topbar__logout" %>
      <% end %>
    </header>
    <% end %>

    <main class="page">
      <%= yield %>
    </main>
  </body>
</html>
