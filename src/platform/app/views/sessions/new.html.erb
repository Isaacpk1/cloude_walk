<% content_for :title, "Entrar" %>
<div class="login-page">
  <div class="login-card">
    <div class="login-card__brand">
      <%= render "shared/cloudwalk_logo" %>
      <span class="topbar__product">Help desk</span>
    </div>
    <div class="page-header" style="margin:0"><div><h1>Entrar</h1><p class="page-header__subtitle">Painel do help desk. Dados sintéticos.</p></div></div>
    <% if flash[:alert] %><p class="login__error" role="alert"><%= flash[:alert] %></p><% end %>
    <%= form_with url: login_path, class: "login" do |form| %>
      <p><%= form.label :email, "E-mail" %><%= form.email_field :email, autocomplete: "username", required: true %></p>
      <p><%= form.label :password, "Senha" %><%= form.password_field :password, autocomplete: "current-password", required: true %></p>
      <p><%= form.submit "Entrar" %></p>
    <% end %>
  </div>
</div>
